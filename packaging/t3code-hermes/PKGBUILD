# Private side-by-side package for the Hermes-enabled T3 Code build.
pkgname=t3code-hermes
pkgver=0.0.38_hermes_v2_1
pkgrel=1
pkgdesc='Private Hermes-enabled T3 Code distribution'
arch=('x86_64')
url='https://github.com/pingdotgg/t3code'
license=('MIT')
depends=(
  'alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs' 'glib2' 'glibc'
  'gtk3' 'hicolor-icon-theme' 'libcups' 'libnotify' 'libx11' 'libxcb'
  'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr'
  'mesa' 'nspr' 'nss' 'pango' 'systemd-libs' 'xdg-utils'
)
optdepends=(
  'openai-codex: drive Codex from the app'
  'claude-code: drive Claude Code from the app'
)
options=('!debug' '!strip')

_appimage='T3-Code-Hermes.AppImage'
source=("$_appimage" 'LICENSE')
sha256sums=(
  '159abfe4d2edad56442fc6870a99ef83967b9287ce41324dad15317c21a21578'
  '935d8f2af0c703f9c39517ee57cc4930b19d02d533be930b63f0e82f93614b43'
)

prepare() {
  chmod +x "$srcdir/$_appimage"
  rm -rf "$srcdir/squashfs-root"
  "$srcdir/$_appimage" --appimage-extract >/dev/null
  test -x "$srcdir/squashfs-root/AppRun"
  test -f "$srcdir/squashfs-root/chrome-sandbox"
}

package() {
  install -d "$pkgdir/opt/$pkgname"
  cp -a --no-preserve=ownership "$srcdir/squashfs-root/." "$pkgdir/opt/$pkgname/"
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/t3code-hermes" <<'EOF'
#!/bin/sh
export T3CODE_HOME="${T3CODE_HERMES_HOME:-$HOME/.t3-hermes}"
export T3CODE_PORT="${T3CODE_HERMES_PORT:-3774}"
export T3CODE_DISABLE_AUTO_UPDATE=true
export XDG_CONFIG_HOME="${T3CODE_HERMES_CONFIG_HOME:-$HOME/.config/t3code-hermes}"
unset APPIMAGE APPDIR
exec /opt/t3code-hermes/AppRun "$@"
EOF

  local icon size_dir
  for icon in "$srcdir"/squashfs-root/usr/share/icons/hicolor/*/apps/t3code.png; do
    size_dir="${icon%/apps/t3code.png}"
    install -Dm644 "$icon" \
      "$pkgdir/usr/share/icons/hicolor/${size_dir##*/}/apps/t3code-hermes.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/t3code-hermes.desktop" <<'EOF'
[Desktop Entry]
Name=T3 Code Hermes
Comment=Private Hermes-enabled T3 Code distribution
Exec=t3code-hermes %U
TryExec=t3code-hermes
Terminal=false
Type=Application
Icon=t3code-hermes
StartupWMClass=t3code
MimeType=x-scheme-handler/t3code;
Categories=Development;
EOF

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
